generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String     @id @default(cuid())
  name                  String?
  email                 String?    @unique
  emailVerified         DateTime?
  image                 String?
  stravaAthleteId       Int        @unique
  lastSyncedAt          DateTime?
  syncCursor            Int?
  syncBefore            Int?
  syncPage              Int        @default(1)
  syncNewest            Int?
  activityRefreshBefore Int?
  activityRefreshPage   Int        @default(1)
  syncVersion           Int        @default(0)
  accounts              Account[]
  sessions              Session[]
  activities            Activity[]
  tiles                 UserTile[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Activity {
  id                   String            @id @default(cuid())
  userId               String
  stravaId             BigInt
  name                 String
  type                 String
  startDate            DateTime
  distance             Float
  movingTime           Int
  elapsedTime          Int
  elevationGain        Float
  averageHeartrate     Float?
  averageSpeed         Float
  summaryPolyline      String?
  tilesProcessed       Boolean           @default(false)
  detailFetched        Boolean           @default(false)
  milestoneChecked     Boolean           @default(false)
  milestoneUnavailable Boolean           @default(false)
  cadenceChecked       Boolean           @default(false)
  cadenceVersion       Int               @default(0)
  cadenceSource        RunWalkSource?
  runningTime          Float?
  walkingTime          Float?
  firstRunningTime     Float?
  lastRunningTime      Float?
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  splits               Split[]
  milestoneEfforts     MilestoneEffort[]
  firstTiles           UserTile[]

  @@unique([userId, stravaId])
  @@index([userId, startDate])
}

model UserTile {
  id              String    @id @default(cuid())
  userId          String
  x               Int
  y               Int
  zoom            Int
  firstActivityId String?
  firstVisitedAt  DateTime
  visitCount      Int
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstActivity   Activity? @relation(fields: [firstActivityId], references: [id], onDelete: SetNull)

  @@unique([userId, zoom, x, y])
  @@index([userId, zoom])
  @@index([firstActivityId])
}

enum RunWalkSource {
  CADENCE
  SPEED
}

enum MilestoneTimeBasis {
  MOVING
  ELAPSED
}

enum MilestoneSource {
  STRAVA
  SPLITS
}

model MilestoneEffort {
  activityId  String
  distanceKey String
  duration    Float
  timeBasis   MilestoneTimeBasis @default(MOVING)
  source      MilestoneSource    @default(STRAVA)
  activity    Activity           @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@id([activityId, distanceKey])
}

model Split {
  id                  String   @id @default(cuid())
  activityId          String
  index               Int
  distance            Float
  movingTime          Int
  elapsedTime         Int
  elevationDifference Float
  averageSpeed        Float
  averageHeartrate    Float?
  activity            Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, index])
}

model StravaRateLimit {
  id           Int      @id
  blockedUntil DateTime
}
